{
  "name": "Waybar Mirror",
  "version": "1.0.0",
  "description": "A Zebar v3 widget pack that mirrors this machine's Waybar TOP-Default layout.",
  "tags": ["glazewm", "waybar", "statusbar"],
  "widgets": [
    {
      "name": "Top Bar",
      "htmlPath": "./index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css"],
      "caching": {
        "defaultDuration": 0,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": ".*"
          },
          {
            "program": "powershell.exe",
            "argsRegex": ".*"
          },
          {
            "program": "explorer",
            "argsRegex": ".*"
          },
          {
            "program": "explorer.exe",
            "argsRegex": ".*"
          },
          {
            "program": "wt",
            "argsRegex": ".*"
          },
          {
            "program": "wt.exe",
            "argsRegex": ".*"
          },
          {
            "program": "rundll32.exe",
            "argsRegex": ".*"
          },
          {
            "program": "taskmgr.exe",
            "argsRegex": ".*"
          }
        ]
      },
      "presets": [
        {
          "name": "Primary top dock",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "34px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "34px"
          }
        }
      ]
    }
  ]
}
